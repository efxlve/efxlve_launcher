<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Efxlve Launcher — Mağaza Doğrulama</title>
    <!--
      SAHTE TAURI ARKA UCU
      Üretim paketini (dist/) gerçek mağaza verisiyle tarayıcıda koşturur ve
      GERÇEK TypeScript mantığını sınar. Statik HTML önizlemesi gibi markup'ı
      elle taklit ETMEZ — bu yüzden mantık hatalarını yakalayabilir.

      Modlar (querystring):
        (varsayılan)  tam veri + tüm senaryolar
        ?mode=empty   hub tamamen boş -> boş durum
        ?mode=fail    hub isteği hata verir -> hata durumu + yeniden dene

      ÖNEMLİ: fixture'lar fixtures.js ile modül script'inden ÖNCE senkron
      yüklenir. fetch() ile sonradan yüklenirse uygulama açılışı boş veriyle
      çalışır ve mağaza/kütüphane boş çizilir (harness hatası, uygulama değil).
    -->
    <script>
      const MODE = new URLSearchParams(location.search).get("mode") || "default";
      window.__VERIFY_MODE__ = MODE;
      window.__VERIFY_ERRORS__ = [];
      window.addEventListener("error", (e) => {
        window.__VERIFY_ERRORS__.push(String(e.message || e.error || e));
      });
      window.addEventListener("unhandledrejection", (e) => {
        window.__VERIFY_ERRORS__.push("unhandledrejection: " + String((e.reason && e.reason.message) || e.reason));
      });

      /**
       * Bozuk/eksik veri senaryosu: gerçek dünyada mağaza API'si eksik alan
       * döndürebilir. Kart çizimi ve fiyat mantığı bunlara dayanmalı.
       */
      function edgeHub(F) {
        const t = (F && F.hub && F.hub.top_sellers) || [];
        const pick = (i) => t[i % Math.max(1, t.length)] || {};
        const items = [
          { ...pick(0), id: "edge-no-art", title: "Görselsiz Oyun", cover: "", wide_art: "" },
          {
            ...pick(1),
            id: "edge-long-title",
            title:
              "Çok Uzun Bir Oyun Adı: Alt Başlık, Sezon Paketi ve Daha Fazlasını İçeren Deluxe Ultimate Collector's Edition",
          },
          { ...pick(2), id: "edge-no-price", original_price: null, discount_price: null, discount_percentage: null },
          { ...pick(3), id: "edge-no-seller", seller: null },
        ];
        return {
          country: "TR",
          free_games_active: [],
          free_games_upcoming: [],
          top_sellers: items,
          featured_discounts: [],
          upcoming_offers: [],
          wishlist_offer_ids: [],
          cart_offer_ids: [],
          updated_at: 0,
        };
      }

      const callbacks = {};
      let cbId = 1;

      window.__TAURI_INTERNALS__ = {
        metadata: {
          currentWindow: { label: "main" },
          currentWebview: { label: "main", windowLabel: "main" },
        },
        transformCallback(cb) {
          const id = cbId++;
          callbacks[id] = cb;
          return id;
        },
        convertFileSrc(p) {
          return p;
        },
        async invoke(cmd, args) {
          const F = window.__VERIFY_FIXTURES__;
          const emptyHub = {
            country: "TR",
            free_games_active: [],
            free_games_upcoming: [],
            top_sellers: [],
            featured_discounts: [],
            upcoming_offers: [],
            wishlist_offer_ids: [],
            cart_offer_ids: [],
            updated_at: 0,
          };
          switch (cmd) {
            // --- Mağaza ---
            case "epic_get_store_hub":
              if (MODE === "fail") throw new Error("Ağ hatası (doğrulama modu)");
              if (MODE === "empty") return emptyHub;
              if (MODE === "edge") return edgeHub(F);
              return F ? F.hub : emptyHub;
            case "epic_get_user_wishlist":
              return [];
            case "epic_get_store_offer_detail": {
              const detail = F && F.details[args.offerId] ? F.details[args.offerId] : null;
              // Test, "sonraki detay isteğini geciktir" diyerek yarış durumu kurar.
              const delay = window.__VERIFY_SLOW_NEXT_DETAIL__ || 0;
              if (delay) {
                window.__VERIFY_SLOW_NEXT_DETAIL__ = 0;
                await new Promise((r) => setTimeout(r, delay));
              }
              return detail;
            }
            case "epic_search_store": {
              const q = String(args.query || "").toLowerCase();
              if (!F) return [];
              const all = [...F.hub.top_sellers, ...F.hub.featured_discounts, ...F.hub.upcoming_offers];
              // "Yalnızca aramada görünen" öğe: hub'da BULUNMAZ. Arama sonuçlarından
              // sepete/isteğe eklenip arama temizlendiğinde kaybolmamalı.
              const searchOnly = {
                id: "search-only-item",
                namespace: "test",
                title: "Yalnızca Arama Sonucu Oyunu",
                description: null,
                cover: all[0] ? all[0].cover : "",
                wide_art: all[0] ? all[0].wide_art : "",
                seller: "Test Yayıncı",
                original_price: "₺1.000,00",
                discount_price: null,
                discount_percentage: null,
                currency: "TRY",
                product_slug: null,
                url_slug: null,
                page_slug: null,
                tags: [],
              };
              return [...all.filter((o) => (o.title || "").toLowerCase().includes(q)), searchOnly].slice(0, 12);
            }
            case "epic_toggle_wishlist":
            case "epic_toggle_cart":
              return true;
            // --- Olay dinleyicileri ---
            case "plugin:event|listen":
              return 1;
            case "plugin:event|unlisten":
              return null;
            // --- Uygulama açılışı (şemalar epic.ts ile BİREBİR eşleşmeli!) ---
            // SetupStatus: camelCase
            case "epic_setup_status":
              return { binaryPath: "C:/mock/legendary.exe", version: "0.20.0", needsDownload: false, altBin: null };
            case "epic_status":
              return { account: "mock-user", account_id: "mock-account-id", country: "TR" };
            // CachedLibrary: dizi DEĞİL, nesne
            case "epic_cached_library":
              return {
                account: "mock-user",
                accountId: "mock-account-id",
                games: F && F.library ? F.library : [],
                installed: [],
                skipped: [],
              };
            case "epic_list_games":
              return F && F.library ? F.library : [];
            case "epic_list_installed":
            case "epic_list_skipped":
            case "epic_detect_egl_games":
            case "epic_get_collections":
            case "epic_get_queue":
              return [];
            case "epic_get_settings":
              return {};
            case "epic_get_achievements_summary":
            case "epic_get_playtimes":
              return {};
            case "epic_get_install_dir":
            case "epic_default_install_dir":
              return "C:/Games";
            case "epic_get_steamgrid_key":
            case "get_recent_launch":
              return null;
            default:
              return null;
          }
        },
      };
    </script>
    <!-- Fixture'lar modülden ÖNCE senkron yüklenir -->
    <script src="fixtures.js"></script>
    <script type="module" crossorigin src="/assets/app.js"></script>
    <link rel="stylesheet" crossorigin href="/assets/app.css" />
    <style>
      #verify-panel {
        position: fixed; right: 0; bottom: 0; z-index: 9999;
        width: 480px; max-height: 68vh; overflow: auto;
        background: #0d0e14; border: 1px solid #2a2b3a; border-radius: 10px 0 0 0;
        font: 11.5px/1.55 Consolas, monospace; color: #d6d7e0; padding: 12px 14px;
      }
      #verify-panel h4 { margin: 0 0 8px; font-size: 12px; color: #a855f7; letter-spacing: .4px; }
      #verify-panel .ok { color: #34d399; }
      #verify-panel .bad { color: #f87171; font-weight: 700; }
      #verify-panel .warn { color: #fbbf24; }
      #verify-panel .head { color: #7dd3fc; margin-top: 7px; }
    </style>
  </head>
  <body>
    <div id="app">
      <header id="titlebar" data-tauri-drag-region>
        <div class="logo" data-tauri-drag-region><i data-lucide="gamepad-2"></i><span>EFXLVE</span></div>
        <nav id="nav">
          <button data-view="store"><i data-lucide="store"></i><span>Mağaza</span></button>
          <button data-view="library" class="active"><i data-lucide="layout-grid"></i><span>Kütüphane</span></button>
          <button data-view="downloads"><i data-lucide="download"></i><span>İndirmeler</span><span id="dl-badge" class="badge hidden"></span></button>
          <button id="account" class="profile" data-view="profile" title="Epic profili"><i data-lucide="circle-user-round"></i><span>Giriş yapılmadı</span></button>
          <button id="btn-offline-mode" class="offline-toggle-btn" data-act="toggle-offline-mode" title="Çevrimdışı Modu Aç/Kapat"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.1 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg><span>Çevrimiçi</span></button>
          <button data-view="settings" class="right" title="Ayarlar"><i data-lucide="settings"></i></button>
        </nav>
        <div class="win-controls">
          <button class="win-btn" data-act="win-minimize" title="Simge Durumuna Küçült"><svg width="10" height="1" viewBox="0 0 10 1"><rect width="10" height="1" fill="currentColor"/></svg></button>
          <button class="win-btn" data-act="win-maximize" title="Ekranı Kapla"><svg id="win-max-icon" width="10" height="10" viewBox="0 0 10 10"><rect width="9" height="9" x="0.5" y="0.5" fill="none" stroke="currentColor" stroke-width="1"/></svg></button>
          <button class="win-btn win-close" data-act="win-close" title="Kapat"><svg width="10" height="10" viewBox="0 0 10 10"><path fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" d="M1 1l8 8M9 1L1 9"/></svg></button>
        </div>
      </header>
      <main id="content"><section id="view"></section></main>
      <footer id="statusbar">
        <div id="recent">Son: —</div>
        <div id="backend-status" title="Rust backend durumu">● bağlanıyor…</div>
      </footer>
    </div>
