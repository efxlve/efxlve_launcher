    <div id="verify-panel"><h4>DOĞRULAMA ÇALIŞIYOR…</h4></div>

    <script type="module">
      const panel = document.getElementById("verify-panel");
      const lines = [];
      let failures = 0;

      function log(text, kind = "") {
        lines.push(`<div class="${kind}">${text}</div>`);
        if (kind === "bad") failures++;
        panel.innerHTML = `<h4>DOĞRULAMA — mod: ${window.__VERIFY_MODE__}</h4>` + lines.join("");
      }
      const section = (name) => log(`— ${name} —`, "head");
      function ok(cond, label, extra = "") {
        log(`${cond ? "PASS" : "FAIL"} — ${label}${extra ? " :: " + extra : ""}`, cond ? "ok" : "bad");
        return cond;
      }
      const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
      const $ = (s) => document.querySelector(s);
      const $$ = (s) => Array.from(document.querySelectorAll(s));

      async function waitFor(fn, timeout = 9000) {
        const t0 = Date.now();
        while (Date.now() - t0 < timeout) {
          try {
            const v = fn();
            if (v) return v;
          } catch {}
          await sleep(80);
        }
        return null;
      }

      /** Arama kutusuna gerçek kullanıcı gibi yaz (input olayı + debounce beklemesi). */
      async function typeSearch(value) {
        const input = $("#store-search-input");
        if (!input) return false;
        input.value = value;
        input.dispatchEvent(new Event("input", { bubbles: true }));
        await sleep(750); // uygulamada 350 ms debounce var
        return true;
      }

      const tabByText = (t) => $$(".store-tab").find((b) => b.textContent.includes(t));
      async function openProductCard(id) {
        const card = await waitFor(() => document.querySelector(`.store-card[data-id="${id}"]`), 4000);
        if (!card) return false;
        card.click();
        await waitFor(() => $(".store-pdp-hero") || $(".store-empty"));
        return Boolean($(".store-pdp-hero"));
      }
      async function goBack() {
        const back = $('.store-product-nav [data-act="store-back-to-hub"]');
        if (back) {
          back.click();
          await sleep(450);
        }
      }

      async function run() {
        const F = window.__VERIFY_FIXTURES__;
        const mode = window.__VERIFY_MODE__;
        if (!F || !F.hub) {
          log("FIXTURE YÜKLENEMEDİ (fixtures.js)", "bad");
          return;
        }

        await sleep(1300);
        const nav = document.querySelector('#nav button[data-view="store"]');
        if (!nav) {
          ok(false, "Mağaza nav düğmesi yok");
          return;
        }
        nav.click();
        if (!(await waitFor(() => $(".store-shell")))) {
          ok(false, "Mağaza görünümü açılamadı");
          return;
        }
        // Kabuk hemen çizilir; hub isteği asenkron gelir. Raflar/skeleton
        // yerleşene kadar beklemeden ölçüm yapmak yanlış negatif üretir.
        await waitFor(() => $$("[data-shelf]").length > 0 || $(".store-skeleton-shelf"), 10000);
        await waitFor(() => $$("[data-shelf]").length > 0, 10000);

        // ============================================================ HATA MODU
        if (mode === "fail") {
          section("Hata durumu (hub isteği başarısız)");
          await waitFor(() => $(".store-empty"));
          ok(Boolean($(".store-empty")), "Hata bloğu gösterildi");
          ok(
            Boolean($(".store-empty h4") && $(".store-empty h4").textContent.includes("alınamadı")),
            "Hata başlığı doğru",
            $(".store-empty h4") ? $(".store-empty h4").textContent : "",
          );
          ok(Boolean($('.store-empty [data-act="refresh-store"]')), "Yeniden dene düğmesi var");
          ok(!$(".store-hero"), "Hata durumunda vitrin çizilmedi");
          ok($$(".store-tab").length === 0, "Hata durumunda sekme çubuğu yok");
          ok(window.__VERIFY_ERRORS__.length === 0, "Hata durumu JS hatası üretmedi",
            window.__VERIFY_ERRORS__.slice(0, 2).join(" | "));
          log(`— ${failures} başarısız —`, failures ? "bad" : "ok");
          return;
        }

        // ============================================================ BOŞ MOD
        if (mode === "empty") {
          section("Boş veri durumu");
          await waitFor(() => $("#store-content"));
          await sleep(400);
          // Kütüphane rafı yerel veriden çizilir, hub boş olsa da görünebilir.
          const shelfKeys = $$("[data-shelf]").map((s) => s.dataset.shelf);
          ok(!shelfKeys.some((k) => k !== "library"), "Hub rafları çizilmedi (vitrin verisi yok)",
            shelfKeys.join(",") || "hiç raf yok");
          ok(Boolean($(".store-empty")), "Kullanıcıya 'vitrin içeriği alınamadı' uyarısı gösterildi");
          ok(!$(".store-hero"), "Vitrin carousel çizilmedi");
          ok($$(".store-tab").length >= 6, "Sekmeler yine de var");
          const ft = tabByText("Ücretsiz");
          if (ft) {
            ft.click();
            await sleep(450);
            ok(Boolean($(".store-empty")), "Ücretsiz sekmesinde boş durum var");
          }
          ok(window.__VERIFY_ERRORS__.length === 0, "Boş veri JS hatası üretmedi",
            window.__VERIFY_ERRORS__.slice(0, 2).join(" | "));
          log(`— ${failures} başarısız —`, failures ? "bad" : "ok");
          return;
        }

        // ================================================== BOZUK VERİ MODU
        if (mode === "edge") {
          section("Bozuk/eksik veri dayanıklılığı");
          // Yalnızca sınır durumu rafına bak: kütüphane rafı da çizilir ve sayıyı şişirir.
          const topShelf = await waitFor(() => $('.store-shelf[data-shelf="top"]'), 8000);
          const cards = topShelf ? Array.from(topShelf.querySelectorAll(".store-card")) : [];
          ok(cards.length === 4, "Dört sınır durumu kartı çizildi", `${cards.length} kart`);

          const noArt = document.querySelector('.store-card[data-id="edge-no-art"]');
          ok(Boolean(noArt), "Görselsiz oyun kartı var");
          ok(Boolean(noArt && noArt.querySelector(".store-card-art-empty")),
            "Görsel yoksa yer tutucu gösteriliyor");
          ok(Boolean(noArt && noArt.querySelector(".store-card-name")),
            "Görselsiz kartta başlık yine okunuyor");

          const longTitle = document.querySelector('.store-card[data-id="edge-long-title"]');
          const nameEl = longTitle && longTitle.querySelector(".store-card-name");
          ok(Boolean(nameEl), "Uzun başlıklı kart çizildi");
          ok(Boolean(nameEl && nameEl.textContent.trim().length > 60), "Uzun başlık kırpılmadan DOM'da",
            nameEl ? `${nameEl.textContent.trim().length} karakter` : "");

          const noPrice = document.querySelector('.store-card[data-id="edge-no-price"] .store-card-price');
          ok(Boolean(noPrice && noPrice.textContent.trim().length > 0),
            "Fiyatı olmayan kartta açıklayıcı metin var", noPrice ? noPrice.textContent.trim() : "BOŞ");

          const noSeller = document.querySelector('.store-card[data-id="edge-no-seller"] .store-card-by');
          ok(Boolean(noSeller && noSeller.textContent.trim().length > 0),
            "Satıcısı olmayan kartta yedek metin var", noSeller ? noSeller.textContent.trim() : "BOŞ");

          // Tıklama hâlâ çalışmalı (detay mock'ta yok -> boş durum mesajı çıkmalı)
          if (noArt) {
            noArt.click();
            await sleep(900);
            ok(Boolean($(".store-product")), "Sınır durum kartına tıklama ürün sayfasını açtı");
            ok(Boolean($(".store-empty")), "Detay bulunamazsa boş sayfa yerine açıklama gösteriliyor");
          }
          ok(window.__VERIFY_ERRORS__.length === 0, "Bozuk veri JS hatası üretmedi",
            window.__VERIFY_ERRORS__.slice(0, 3).join(" | "));
          log(`— ${failures} başarısız —`, failures ? "bad" : "ok");
          return;
        }

        // ======================================================= TAM VERİ MODU
        log(`fixture: aktif=${F.hub.free_games_active.length} gelecek=${F.hub.free_games_upcoming.length} ` +
            `top=${F.hub.top_sellers.length} indirim=${F.hub.featured_discounts.length} yakında=${F.hub.upcoming_offers.length}`);

        section("Kabuk ve sekmeler");
        ok($$(".store-tab").length >= 6, "Bölüm sekmeleri var", `${$$(".store-tab").length} sekme`);
        ok($$(".store-tab.active").length === 1, "Tek aktif sekme");
        ok($$(".store-tab.active")[0].textContent.includes("Vitrin"), "Varsayılan sekme Vitrin");

        log("DOM rafları: " + $$("[data-shelf]").map((s) => s.dataset.shelf).join(", "), "warn");
        log("hub aktif: " + F.hub.free_games_active.map((o) => o.title).join(" | "), "warn");
        log("hub gelecek: " + F.hub.free_games_upcoming.map((o) => o.title).join(" | "), "warn");

        section("Ücretsiz / gelecek ayrımı");
        const freeShelf = $('.store-shelf[data-shelf="free"]');
        ok(Boolean(freeShelf), "Şu An Ücretsiz rafı var");
        if (freeShelf) {
          log("free raf kartları: " +
            Array.from(freeShelf.querySelectorAll(".store-card")).map((c) => c.dataset.title).join(" | "), "warn");
        }
        const freeCards = freeShelf ? freeShelf.querySelectorAll(".store-card").length : -1;
        ok(freeCards === F.hub.free_games_active.length, "Ücretsiz rafı yalnızca AKTİF promosyonları içeriyor",
          `raf=${freeCards} beklenen=${F.hub.free_games_active.length}`);
        const soonShelf = $('.store-shelf[data-shelf="free-soon"]');
        ok(Boolean(soonShelf), "Gelecek Hafta Ücretsiz rafı var");
        if (soonShelf) {
          const n = soonShelf.querySelectorAll(".store-card").length;
          ok(n === F.hub.free_games_upcoming.length, "Gelecek rafı doğru kart sayısı",
            `raf=${n} beklenen=${F.hub.free_games_upcoming.length}`);
          ok(soonShelf.querySelectorAll(".store-card-deal").length === 0,
            "Gelecek promosyon kartlarında ÜCRETSİZ ROZETİ YOK");
          ok(soonShelf.querySelectorAll(".store-price-soon").length === n,
            "Gelecek kartları 'Yakında Ücretsiz' stilini kullanıyor");
        }
        if (freeShelf) {
          ok(freeShelf.querySelectorAll(".store-card-deal.free").length === F.hub.free_games_active.length,
            "Aktif ücretsiz kartlarında rozet var");
        }

        section("İndirim rozeti tutarlılığı");
        // DEĞİŞMEZ: rozetteki yüzde, gösterilen liste/güncel fiyat farkıyla uyuşmalı.
        // egdata'nın `appliedRules` alanı süresi geçmiş kampanya kuralı döndürebiliyor
        // ve yüzdesi gerçek indirimle uyuşmuyor; yüzde FİYATLARDAN hesaplanmalı.
        {
          const parsePrice = (t) =>
            Number(String(t).replace(/[^\d.,]/g, "").replace(/\./g, "").replace(",", ".")) || 0;
          const mismatches = [];
          let checked = 0;
          for (const c of $$(".store-shelf .store-card, .store-grid .store-card").slice(0, 40)) {
            const deal = c.querySelector(".store-card-deal");
            if (!deal || deal.classList.contains("free")) continue;
            const m = deal.textContent.match(/(\d+)/);
            if (!m) continue;
            const badge = Number(m[1]);
            const o = parsePrice(c.querySelector(".store-price-old")?.textContent || "");
            const n = parsePrice(c.querySelector(".store-price-now")?.textContent || "");
            if (!o || !n) continue;
            checked++;
            const real = Math.round(((o - n) / o) * 100);
            if (Math.abs(real - badge) > 1) {
              mismatches.push(`"${(c.dataset.title || "").slice(0, 22)}" rozet=-%${badge} gerçek=-%${real}`);
            }
          }
          ok(checked > 0, "Fiyat karşılaştırması yapılabildi", `${checked} kart`);
          ok(mismatches.length === 0, "İndirim rozeti gösterilen fiyatlarla TUTARLI",
            mismatches.slice(0, 3).join(" | ") || "tümü tutarlı");
        }

        section("Kütüphane rafı (appName kimliği)");
        const libShelf = $('.store-shelf[data-shelf="library"]');
        ok(Boolean(libShelf), "Kütüphane rafı çizildi");
        if (libShelf) {
          const libCards = Array.from(libShelf.querySelectorAll(".store-card"));
          ok(libCards.length > 0, "Kütüphane rafında kart var", `${libCards.length} kart`);
          ok(libCards.every((c) => c.dataset.act === "store-open-owned"),
            "TÜM kütüphane kartları kütüphane modalını açar (mağaza detayı değil)");
          ok(libShelf.querySelectorAll(".store-quick-btn").length === 0,
            "Kütüphane kartlarında istek/sepet düğmesi yok");
          ok(libShelf.querySelectorAll(".store-tag.owned").length > 0, "Kütüphane kartları 'Kütüphanede' rozetli");
        }

        section("Vitrin carousel");
        const track = $("#store-hero-track");
        ok(Boolean(track), "Carousel rayı var");
        const thumbs = $$(".store-hero-thumb");
        ok(thumbs.length >= 2, "Küçük görsel şeridi var", `${thumbs.length} görsel`);
        ok($$(".store-hero-dot").length === thumbs.length, "Nokta sayısı slayt sayısına eşit");
        if (thumbs.length >= 2) {
          const before = track.style.transform;
          thumbs[1].click();
          await sleep(350);
          ok(track.style.transform !== before, "Küçük görsele tıklama slaytı değiştirdi",
            `${before || "(bos)"} -> ${track.style.transform}`);
          ok(thumbs[1].classList.contains("active"), "Tıklanan görsel aktif işaretlendi");
          ok($$(".store-hero-dot")[1].classList.contains("active"), "İlgili nokta aktif işaretlendi");
          const nextBtn = $(".store-hero-nav.next");
          if (nextBtn) {
            nextBtn.click();
            await sleep(350);
            ok($$(".store-hero-dot")[2] && $$(".store-hero-dot")[2].classList.contains("active"),
              "Sonraki düğmesi ilerletti");
          }
          thumbs[0].click();
          await sleep(300);
        }

        section("Arama akışı");
        const searchInput = $("#store-search-input");
        ok(Boolean(searchInput), "Arama kutusu var");
        if (searchInput && F.hub.top_sellers.length) {
          const term = F.hub.top_sellers[0].title.split(" ")[0];
          await typeSearch(term);
          ok(Boolean(await waitFor(() => $(".store-grid"), 6000)), "Arama sonuç ızgarası çizildi", term);
          ok($("#store-hero-host").style.display === "none", "Arama sırasında vitrin gizlendi");
          const clearBtn = $(".store-search-clear");
          ok(Boolean(clearBtn) && clearBtn.style.display !== "none", "Temizle düğmesi göründü");
          if (clearBtn) {
            clearBtn.click();
            await sleep(550);
            ok($("#store-hero-host").style.display !== "none", "Temizleyince vitrin geri geldi");
            ok(!$(".store-search-clear") || $(".store-search-clear").style.display === "none",
              "Temizleyince temizle düğmesi gizlendi");
            ok(searchInput.value === "", "Arama kutusu boşaltıldı", `"${searchInput.value}"`);
          }
        }

        section("Sekme geçişleri");
        const freeTab = tabByText("Ücretsiz");
        if (freeTab) {
          freeTab.click();
          await sleep(550);
          const secs = $$("#store-content .store-shelf-grid");
          ok(secs.length === 2, "Ücretsiz sekmesi AKTİF ve GELECEK olarak iki bölüm gösteriyor", `${secs.length} bölüm`);
          ok($$(".store-tab.active").length === 1, "Tek aktif sekme");
        }
        const wishTab = tabByText("İstek Listem");
        if (wishTab) {
          wishTab.click();
          await sleep(500);
          ok(Boolean($(".store-empty")), "Boş istek listesinde boş durum mesajı var");
        }
        const cartTab = tabByText("Sepetim");
        if (cartTab) {
          cartTab.click();
          await sleep(500);
          ok(Boolean($(".store-empty")), "Boş sepette boş durum mesajı var");
        }

        // NOT: Bu bölüm sepeti DOLDURUR, bu yüzden yukarıdaki "boş sepet"
        // iddialarından SONRA gelmek zorundadır.
        section("Sepete ekleme kalıcılığı (arama sonrası)");
        // Senaryo: arama sonucundan (hub'da OLMAYAN bir öğe) sepete ekle, aramayı
        // temizle, Sepetim'e geç. Öğe kaybolmamalı — sepet yalnızca kimlik saklar
        // ve öğe hub'da yoksa çözülemez.
        {
          const v = tabByText("Vitrin");
          if (v) { v.click(); await sleep(400); }
          await typeSearch("Yalnızca");
          const grid = await waitFor(() => $(".store-grid"), 6000);
          const only = grid ? document.querySelector('.store-card[data-id="search-only-item"]') : null;
          ok(Boolean(only), "Aramada hub dışı öğe göründü");
          if (only) {
            const cartBtn = only.querySelector("[data-cart-btn]");
            ok(Boolean(cartBtn), "Sepete ekle düğmesi var");
            if (cartBtn) {
              cartBtn.click();
              await sleep(600);
              const clr = $(".store-search-clear");
              if (clr) { clr.click(); await sleep(600); }
              const ct = tabByText("Sepetim");
              if (ct) {
                ct.click();
                await sleep(600);
                const cards = $$("#store-content .store-card");
                ok(cards.some((c) => c.dataset.id === "search-only-item"),
                  "Aramadan sepete eklenen oyun Sepetim'de görünüyor", `${cards.length} kart`);
              }
            }
          }
        }

        section("Ürün sayfası — CDN içeriği OLAN oyun");
        const vitrin = tabByText("Vitrin");
        if (vitrin) { vitrin.click(); await sleep(550); }
        const cdnGame = F.hub.top_sellers.find((o) => F.details[o.id] && F.details[o.id].has_page_content);
        if (cdnGame && (await openProductCard(cdnGame.id))) {
          ok(true, "Ürün sayfası açıldı", cdnGame.title);
          ok(Boolean($(".store-pdp-pricebox")), "Yüzen fiyat kutusu var");
          ok(Boolean($(".store-mediastrip")), "Medya şeridi var");
          ok(Boolean($(".store-spec-table")), "Sistem gereksinimleri tablosu var");
          ok(Boolean($(".store-pdp-side")), "Sağ künye sütunu var");
          ok($$(".store-pdp-title").length === 1, "Başlık tek kez basılıyor");
          ok(!$(".store-limited-note"), "CDN içerikli oyunda 'sınırlı künye' notu YOK");
          ok($$(".store-lang-block").length > 0, "Diller bölümü dolu");
        } else {
          ok(false, "CDN içerikli oyun açılamadı", cdnGame ? cdnGame.title : "fixture'da yok");
        }

        section("Ürün sayfası — CDN içeriği OLMAYAN oyun");
        await goBack();
        const bareGame = F.hub.upcoming_offers.find((o) => F.details[o.id] && !F.details[o.id].has_page_content);
        if (bareGame) {
          if (await openProductCard(bareGame.id)) {
            ok(true, "Sade künyeli oyun da açılıyor", bareGame.title);
            ok(Boolean($(".store-limited-note")), "Sınırlı künye notu gösterildi");
            ok(!$(".store-mediastrip"), "Medya yoksa şerit çizilmiyor");
          } else {
            ok(false, "Sade künyeli oyun açılamadı", bareGame.title);
          }
        } else {
          log("sade künyeli oyun fixture'da yok — atlandı", "warn");
        }

        section("Ücretsiz oyun ürün sayfası");
        await goBack();
        const freeGame = F.hub.free_games_active[0];
        if (freeGame) {
          if (await openProductCard(freeGame.id)) {
            const cta = $(".store-pdp-pricebox .store-cta");
            ok(Boolean(cta), "Ücretsiz oyunda ana CTA var");
            ok(Boolean(cta && /Ücretsiz al|Kütüphanede aç/i.test(cta.textContent)),
              "Ücretsiz oyun CTA metni doğru", cta ? cta.textContent.trim() : "");
            ok(Boolean($(".store-pdp-pricebox .store-price-free, .store-pdp-pricebox .store-tag.owned")),
              "Fiyat alanı ücretsiz/kütüphanede olarak işaretli");
          } else {
            ok(false, "Ücretsiz oyun ürün sayfası açılamadı", freeGame.title);
          }
        }

        section("Medya görüntüleyici");
        await goBack();
        if (cdnGame && (await openProductCard(cdnGame.id))) {
          const shot = $(".store-shot") || $(".store-mediastrip-item");
          if (shot) {
            shot.click();
            ok(Boolean(await waitFor(() => $("#store-lightbox"), 3000)), "Görüntüleyici açıldı");
            document.dispatchEvent(new KeyboardEvent("keydown", { key: "ArrowRight", bubbles: true }));
            await sleep(250);
            ok(Boolean($("#store-lightbox")), "Ok tuşuyla gezinirken açık kaldı");
            document.dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", bubbles: true }));
            await sleep(250);
            ok(!$("#store-lightbox"), "Escape ile kapandı");
          } else {
            ok(false, "Galeri öğesi bulunamadı");
          }
        }

        section("Eskimiş yanıt koruması (yarış durumu)");
        // Senaryo: A oyununu aç (yanıtı 4 sn geciktir), hemen geri dön, B'yi aç.
        // A'nın geciken yanıtı ekrana yazılırsa kullanıcı B sayfasında A'yı görür.
        {
          const back0 = $('.store-product-nav [data-act="store-back-to-hub"]');
          if (back0) { back0.click(); await sleep(450); }
          const cards = $$('.store-shelf[data-shelf="discounts"] .store-card, .store-shelf .store-card');
          const a = cards[0];
          const b = cards.find((c) => c.dataset.id !== a.dataset.id);
          if (a && b) {
            const titleB = b.dataset.title;
            const idB = b.dataset.id;
            window.__VERIFY_SLOW_NEXT_DETAIL__ = 4000;
            a.click();
            await sleep(250); // A isteği uçuyor
            await goBack();
            await sleep(200);
            // DİKKAT: goBack() DOM'u yeniden çizer, önceki kart referansı kopmuş olur.
            const b2 = await waitFor(() => document.querySelector(`.store-card[data-id="${idB}"]`), 4000);
            if (!b2) {
              ok(false, "Yarış testi: ikinci kart yeniden bulunamadı");
            } else {
              b2.click();
              await waitFor(() => $(".store-pdp-hero"), 4000);
              await sleep(4600); // A'nın gecikmiş yanıtı gelmiş olmalı
              const shown = $(".store-pdp-title") ? $(".store-pdp-title").textContent.trim() : "";
              ok(shown === titleB, "Geciken yanıt ekranı ele geçirmedi", `görünen="${shown}" beklenen="${titleB}"`);
            }
          } else {
            log("yarış testi için iki kart bulunamadı — atlandı", "warn");
          }
        }

        section("Görünüm geçişi ve kaydırma");
        const view = document.getElementById("view");
        if ($(".store-pdp-hero")) {
          view.scrollTop = 900;
          await goBack();
          ok(Boolean($(".store-hero") || $(".store-tabbar")), "Vitrine dönüldü");
          ok(view.scrollTop === 0, "Kaydırma başa alındı", `scrollTop=${view.scrollTop}`);
        }

        section("Kategori görünümü");
        const tile = $(".store-cat-tile");
        if (tile) {
          const cat = tile.dataset.cat;
          view.scrollTop = 600;
          tile.click();
          await sleep(550);
          ok(Boolean($(".store-cat-head")), "Kategori görünümü açıldı", cat);
          ok($$(".store-tab.active").length === 1, "Kategori görünümünde bir sekme aktif");
          ok(view.scrollTop === 0, "Kategori geçişinde kaydırma başa alındı");
          const backCat = $('.store-cat-head [data-act="store-filter"]');
          if (backCat) {
            backCat.click();
            await sleep(500);
            ok($("#store-hero-host").style.display !== "none", "Vitrine dönüldü (kategori kapatıldı)");
          }
        } else {
          log("kategori kutucuğu yok — atlandı", "warn");
        }

        section("İstek listesi yerinde güncelleme");
        const heroBefore = $(".store-hero");
        const quick = $(".store-quick-btn[data-wish-btn]");
        if (quick) {
          quick.click();
          await sleep(500);
          ok($(".store-hero") === heroBefore, "İstek listesi tıklaması vitrini yeniden çizmedi");
          ok(quick.classList.contains("active"), "Düğme aktif duruma geçti");
        }

        section("Görseller ve hatalar");
        const heroImg = $(".store-hero-art");
        if (heroImg) {
          const loaded = await waitFor(() => heroImg.complete && heroImg.naturalWidth > 0, 15000);
          ok(Boolean(loaded), "Hero ana görseli yüklendi",
            heroImg.naturalWidth ? `${heroImg.naturalWidth}x${heroImg.naturalHeight}` : "YÜKLENMEDİ");
        }
        const cardImgs = $$(".store-shelf .store-card-art img").slice(0, 10);
        if (cardImgs.length) {
          await waitFor(() => cardImgs.every((i) => i.complete), 15000);
          await sleep(400);
          const broken = cardImgs.filter((i) => i.complete && i.naturalWidth === 0);
          ok(broken.length === 0, "Kart görselleri kırık değil",
            `${cardImgs.length - broken.length}/${cardImgs.length} yüklendi`);
        }
        ok(window.__VERIFY_ERRORS__.length === 0, "JavaScript hatası yok",
          window.__VERIFY_ERRORS__.slice(0, 3).join(" | "));

        log(`— ${failures} başarısız —`, failures ? "bad" : "ok");
      }

      window.addEventListener("load", () => setTimeout(run, 300));
    </script>
  </body>
</html>
