{
  "app-id": "com.efxlve.launcher",
  "runtime": "org.gnome.Platform",
  "runtime-version": "46",
  "sdk": "org.gnome.Sdk",
  "command": "efxlve-launcher",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--device=dri",
    "--filesystem=home",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.freedesktop.portal.Desktop",
    "--env=WEBKIT_DISABLE_DMABUF_RENDERER=1"
  ],
  "modules": [
    {
      "name": "efxlve-launcher",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/bin /app/share/applications /app/share/icons/hicolor/256x256/apps",
        "cp -a . /app/",
        "install -Dm755 efxlve-launcher-wrapper /app/bin/efxlve-launcher",
        "install -Dm644 com.efxlve.launcher.desktop /app/share/applications/com.efxlve.launcher.desktop",
        "install -Dm644 com.efxlve.launcher.png /app/share/icons/hicolor/256x256/apps/com.efxlve.launcher.png"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "appimage"
        },
        {
          "type": "file",
          "path": "efxlve-launcher-wrapper"
        },
        {
          "type": "file",
          "path": "com.efxlve.launcher.desktop"
        },
        {
          "type": "file",
          "path": "com.efxlve.launcher.png"
        }
      ]
    }
  ]
}
