{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Efxlve Launcher",
  "version": "0.1.13",
  "identifier": "com.efxlve.launcher",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Efxlve Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "backgroundColor": "#07080d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFNDFDOEMwNTgyOEUwMjAKUldRZzRDaFl3TWhCUGdBditmVmQzaysxM2puTGwxbmhwUlRSMk1iRldWMmt6dXdyQVRFVkhyTlMK",
      "endpoints": [
        "https://github.com/efxlve/efxlve_launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
