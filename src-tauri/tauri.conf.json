{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Efxlve Launcher",
  "version": "0.1.0",
  "identifier": "com.efxlve.launcher",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Efxlve Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "decorations": false
      },
      {
        "label": "social",
        "title": "Efxlve - Arkadaşlar ve Sohbet",
        "url": "index.html?window=social",
        "width": 960,
        "height": 640,
        "minWidth": 680,
        "minHeight": 480,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
